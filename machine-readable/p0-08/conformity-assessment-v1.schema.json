{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/QuJindai/automotive-smart-manufacturing-standards-archive/machine-readable/p0-08/conformity-assessment-v1.schema.json",
  "title":"P-CAE V1 Conformity Assessment Package",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","assessment_id","profile","assessment_level","assessment_time","assessor","assessment_object","baseline","observed_baseline","evidence_refs","execution_summary","not_applicable","exceptions","assurance_chain","required_outcomes","effectiveness_sources","claimed_effectiveness_metrics","validity","drifts","declared_material_drift","claimed_reevaluation_state","declared_decision","certification_claim","signature_state","statement_type","trace_bindings"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "assessment_id":{"type":"string","minLength":1},
    "profile":{"$ref":"#/$defs/profile"},
    "assessment_level":{"enum":["C0","C1","C2","C3"]},
    "assessment_time":{"type":"string","format":"date-time"},
    "assessor":{"$ref":"#/$defs/assessor"},
    "assessment_object":{"$ref":"#/$defs/assessment_object"},
    "baseline":{"$ref":"#/$defs/baseline"},
    "observed_baseline":{"$ref":"#/$defs/baseline"},
    "evidence_refs":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/evidence_ref"}},
    "execution_summary":{"$ref":"#/$defs/execution_summary"},
    "not_applicable":{"type":"array","items":{"$ref":"#/$defs/not_applicable"}},
    "exceptions":{"type":"array","items":{"$ref":"#/$defs/exception"}},
    "assurance_chain":{"type":"array","items":{"$ref":"#/$defs/assurance_entry"}},
    "required_outcomes":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/required_outcome"}},
    "effectiveness_sources":{"$ref":"#/$defs/effectiveness_sources"},
    "claimed_effectiveness_metrics":{"$ref":"#/$defs/effectiveness_metrics"},
    "validity":{"$ref":"#/$defs/validity"},
    "drifts":{"type":"array","items":{"$ref":"#/$defs/drift"}},
    "declared_material_drift":{"type":"boolean"},
    "claimed_reevaluation_state":{"enum":["REQUIRED","NOT_REQUIRED"]},
    "declared_decision":{"enum":["PASS","FAIL","BLOCKED","NOT_APPLICABLE"]},
    "certification_claim":{"const":false},
    "signature_state":{"enum":["UNSIGNED","SIGNED_VERIFIED","SIGNED_UNVERIFIED"]},
    "statement_type":{"const":"CONFORMITY_EVALUATION_STATEMENT"},
    "trace_bindings":{"type":"array","minItems":20,"maxItems":20,"items":{"$ref":"#/$defs/trace_binding"}},
    "project_binding":{"$ref":"#/$defs/project_binding"},
    "continuous_monitoring":{"$ref":"#/$defs/continuous_monitoring"},
    "signature":{"type":"object"}
  },
  "$defs":{
    "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "git_blob_sha":{"type":"string","pattern":"^[a-f0-9]{40}$"},
    "profile":{"type":"object","additionalProperties":false,"required":["id","version"],"properties":{"id":{"const":"P-CAE-AUTO-R14"},"version":{"const":"1.0"}}},
    "assessor":{"type":"object","additionalProperties":false,"required":["role","assessor_id"],"properties":{"role":{"enum":["SUPPLIER_DECLARANT","LAB_EVALUATOR","FAT_SAT_EVALUATOR","OPERATIONS_MONITOR"]},"assessor_id":{"type":"string","minLength":1}}},
    "assessment_object":{"type":"object","additionalProperties":false,"required":["object_id","object_type"],"properties":{"object_id":{"type":"string","minLength":1},"object_type":{"type":"string","minLength":1}}},
    "baseline":{"type":"object","additionalProperties":false,"required":["profile_version","program_version","parameter_hash","interface_version","p0_02_status_blob_sha","p0_06_status_blob_sha"],"properties":{"profile_version":{"type":"string","minLength":1},"program_version":{"type":"string","minLength":1},"parameter_hash":{"$ref":"#/$defs/sha256"},"interface_version":{"type":"string","minLength":1},"p0_02_status_blob_sha":{"$ref":"#/$defs/git_blob_sha"},"p0_06_status_blob_sha":{"$ref":"#/$defs/git_blob_sha"}}},
    "evidence_ref":{"type":"object","additionalProperties":false,"required":["evidence_id","proof_type","uri","size_bytes","sha256"],"properties":{"evidence_id":{"type":"string","minLength":1},"proof_type":{"enum":["MODEL","PROFILE_DECLARATION","AUTOMATED_TEST","LAB_REPORT","FAT_SAT_EVIDENCE","CONTINUOUS_EVIDENCE","ATTESTATION","EXCEPTION_RECORD"]},"uri":{"type":"string","minLength":1},"size_bytes":{"type":"integer","minimum":0},"sha256":{"$ref":"#/$defs/sha256"},"source_stage":{"type":"string","minLength":1},"execution_mode":{"enum":["AUTOMATED","MANUAL"]}}},
    "execution_summary":{"type":"object","additionalProperties":false,"required":["automatable_required","automated_executed","manual_passed_automatable"],"properties":{"automatable_required":{"type":"integer","minimum":0},"automated_executed":{"type":"integer","minimum":0},"manual_passed_automatable":{"type":"integer","minimum":0}}},
    "not_applicable":{"type":"object","additionalProperties":false,"required":["test_id","justification"],"properties":{"test_id":{"type":"string","pattern":"^CAE-T[0-9]{3}$"},"justification":{"type":"string","minLength":1}}},
    "exception":{"type":"object","additionalProperties":true,"properties":{"exception_id":{"type":"string"},"masks_required_failure":{"type":"boolean"},"reason":{"type":"string"}}},
    "assurance_entry":{"type":"object","additionalProperties":false,"required":["assessment_id","evidence_id","level","decision","lifecycle_state","valid_until"],"properties":{"assessment_id":{"type":"string","minLength":1},"evidence_id":{"type":"string","minLength":1},"level":{"enum":["C0","C1","C2"]},"decision":{"const":"PASS"},"lifecycle_state":{"const":"VALID"},"valid_until":{"type":"string","format":"date-time"}}},
    "required_outcome":{"type":"object","additionalProperties":false,"required":["requirement_id","result"],"properties":{"requirement_id":{"type":"string","minLength":1},"result":{"enum":["PASS","FAIL","BLOCKED","NOT_APPLICABLE"]}}},
    "metric_source":{"type":"object","additionalProperties":false,"required":["numerator","denominator","source_evidence_ids"],"properties":{"numerator":{"type":"integer","minimum":0},"denominator":{"type":"integer","minimum":0},"source_evidence_ids":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}}},
    "metric_value":{"type":"object","additionalProperties":false,"required":["numerator","denominator","source_evidence_ids","status","value"],"properties":{"numerator":{"type":"integer","minimum":0},"denominator":{"type":"integer","minimum":0},"source_evidence_ids":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"status":{"enum":["MEASURED","NOT_APPLICABLE","INVALID"]},"value":{"type":["number","null"]}}},
    "effectiveness_sources":{"type":"object","additionalProperties":false,"required":["machine_readable_coverage","requirement_testability","automation_rate","evidence_completeness","applicable_required_pass_rate","cross_implementation_reproducibility","regression_stability","c3_drift_closure_rate"],"properties":{"machine_readable_coverage":{"$ref":"#/$defs/metric_source"},"requirement_testability":{"$ref":"#/$defs/metric_source"},"automation_rate":{"$ref":"#/$defs/metric_source"},"evidence_completeness":{"$ref":"#/$defs/metric_source"},"applicable_required_pass_rate":{"$ref":"#/$defs/metric_source"},"cross_implementation_reproducibility":{"$ref":"#/$defs/metric_source"},"regression_stability":{"$ref":"#/$defs/metric_source"},"c3_drift_closure_rate":{"$ref":"#/$defs/metric_source"}}},
    "effectiveness_metrics":{"type":"object","additionalProperties":false,"required":["machine_readable_coverage","requirement_testability","automation_rate","evidence_completeness","applicable_required_pass_rate","cross_implementation_reproducibility","regression_stability","c3_drift_closure_rate"],"properties":{"machine_readable_coverage":{"$ref":"#/$defs/metric_value"},"requirement_testability":{"$ref":"#/$defs/metric_value"},"automation_rate":{"$ref":"#/$defs/metric_value"},"evidence_completeness":{"$ref":"#/$defs/metric_value"},"applicable_required_pass_rate":{"$ref":"#/$defs/metric_value"},"cross_implementation_reproducibility":{"$ref":"#/$defs/metric_value"},"regression_stability":{"$ref":"#/$defs/metric_value"},"c3_drift_closure_rate":{"$ref":"#/$defs/metric_value"}}},
    "validity":{"type":"object","additionalProperties":false,"required":["valid_from","valid_until","revoked","superseded"],"properties":{"valid_from":{"type":"string","format":"date-time"},"valid_until":{"type":"string","format":"date-time"},"revoked":{"type":"boolean"},"superseded":{"type":"boolean"}}},
    "drift":{"type":"object","additionalProperties":false,"required":["drift_id","material","status","description"],"properties":{"drift_id":{"type":"string","minLength":1},"material":{"type":"boolean"},"status":{"enum":["OPEN","CLOSED"]},"description":{"type":"string","minLength":1}}},
    "trace_binding":{"type":"object","additionalProperties":false,"required":["requirement_id","test_id","evidence_ids"],"properties":{"requirement_id":{"type":"string","pattern":"^CAE-R[0-9]{3}$"},"test_id":{"type":"string","pattern":"^CAE-T[0-9]{3}$"},"evidence_ids":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}}},
    "project_binding":{"type":"object","additionalProperties":false,"required":["project_id","instance_id","plant_scope"],"properties":{"project_id":{"type":"string","minLength":1},"instance_id":{"type":"string","minLength":1},"plant_scope":{"type":"string","minLength":1}}},
    "continuous_monitoring":{"type":"object","additionalProperties":false,"required":["window_start","window_end","required_days","coverage_ratio"],"properties":{"window_start":{"type":"string","format":"date-time"},"window_end":{"type":"string","format":"date-time"},"required_days":{"type":"integer","minimum":1},"coverage_ratio":{"type":"number","minimum":0,"maximum":1}}}
  }
}
