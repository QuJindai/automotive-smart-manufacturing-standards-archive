{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QuJindai/automotive-smart-manufacturing-standards-archive/machine-readable/p0-08/conformity-assessment-v1.schema.json",
  "title": "P-CAE V1 Conformity Assessment Package",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "assessment_id", "profile", "assessment_level", "assessment_time",
    "assessor", "assessment_object", "baseline", "observed_baseline", "evidence_refs",
    "execution_summary", "required_outcomes", "effectiveness_sources", "claimed_effectiveness_metrics",
    "validity", "declared_decision", "claimed_reevaluation_state", "certification_claim", "signature_state"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "assessment_id": {"type": "string", "minLength": 1},
    "profile": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {"id": {"const": "P-CAE-AUTO-R14"}, "version": {"const": "1.0"}},
      "additionalProperties": false
    },
    "assessment_level": {"enum": ["C0", "C1", "C2", "C3"]},
    "assessment_time": {"type": "string", "format": "date-time"},
    "assessor": {
      "type": "object",
      "required": ["role", "assessor_id"],
      "properties": {"role": {"enum": ["SUPPLIER_DECLARANT", "LAB_EVALUATOR", "FAT_SAT_EVALUATOR", "OPERATIONS_MONITOR"]}, "assessor_id": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}},
    "certification_claim": {"const": false},
    "signature_state": {"enum": ["UNSIGNED", "SIGNED_VERIFIED", "SIGNED_UNVERIFIED"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence_ref": {
      "type": "object",
      "additionalProperties": true,
      "required": ["evidence_id", "proof_type", "uri", "size_bytes", "sha256"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "proof_type": {"enum": ["MODEL", "PROFILE_DECLARATION", "AUTOMATED_TEST", "LAB_REPORT", "FAT_SAT_EVIDENCE", "CONTINUOUS_EVIDENCE", "ATTESTATION", "EXCEPTION_RECORD"]},
        "uri": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
