{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QuJindai/automotive-smart-manufacturing-standards-archive/machine-readable/v1/evidence.schema.json",
  "title": "Automotive Smart Manufacturing Conformity Evidence Bundle V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_bundle_id",
    "profile_version",
    "system_under_test",
    "run_started_at",
    "test_results"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evidence_bundle_id": {"type": "string", "minLength": 1},
    "profile_version": {"type": "string"},
    "system_under_test": {"$ref": "#/$defs/sut"},
    "run_started_at": {"type": "string", "format": "date-time"},
    "run_completed_at": {"type": ["string", "null"], "format": "date-time"},
    "environment": {"type": "object", "additionalProperties": true},
    "test_results": {"type": "array", "items": {"$ref": "#/$defs/test_result"}, "minItems": 1},
    "bundle_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "signatures": {"type": "array", "items": {"$ref": "#/$defs/signature"}}
  },
  "$defs": {
    "sut": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "site"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "site": {"type": "string"},
        "asset_ids": {"type": "array", "items": {"type": "string"}},
        "model_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "name", "uri", "sha256"],
      "properties": {
        "artifact_id": {"type": "string"},
        "name": {"type": "string"},
        "uri": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "mime_type": {"type": ["string", "null"]},
        "created_at": {"type": ["string", "null"], "format": "date-time"},
        "source_system": {"type": ["string", "null"]}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_id", "status"],
      "properties": {
        "assertion_id": {"type": "string"},
        "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_APPLICABLE"]},
        "expected": {},
        "observed": {},
        "message": {"type": ["string", "null"]}
      }
    },
    "deviation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deviation_id", "description", "disposition"],
      "properties": {
        "deviation_id": {"type": "string"},
        "description": {"type": "string"},
        "risk": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
        "disposition": {"enum": ["ACCEPT", "REWORK", "RETEST", "REJECT", "OPEN"]},
        "closure_evidence_ref": {"type": ["string", "null"]}
      }
    },
    "test_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_id", "level", "result", "executed_at", "linked_rule_ids", "assertions", "artifacts"],
      "properties": {
        "test_id": {"type": "string", "pattern": "^(AAS|AI|ME)-T[0-9]{3}$"},
        "level": {"enum": ["C0", "C1", "C2", "C3"]},
        "result": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_APPLICABLE"]},
        "executed_at": {"type": "string", "format": "date-time"},
        "executor": {"type": ["string", "null"]},
        "linked_rule_ids": {"type": "array", "items": {"type": "string"}},
        "metrics": {"type": "object", "additionalProperties": {"type": ["number", "integer", "string", "boolean", "null"]}},
        "observations": {"type": ["string", "null"]},
        "assertions": {"type": "array", "items": {"$ref": "#/$defs/assertion"}},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
        "deviations": {"type": "array", "items": {"$ref": "#/$defs/deviation"}}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signer", "algorithm", "signature_ref"],
      "properties": {
        "signer": {"type": "string"},
        "algorithm": {"type": "string"},
        "signature_ref": {"type": "string"},
        "signed_at": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  }
}